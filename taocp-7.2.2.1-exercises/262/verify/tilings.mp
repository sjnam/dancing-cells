% Exercise 7.2.2.1-262.  Four pictures, all of them uniformly random members of
% the families the exercise asks about, drawn from their ZDDs: a domino tiling
% of S_32; a domino tiling of the Aztec diamond of order 12, with the arctic
% circle of radius m/sqrt(2) on top of it; a diamond tiling of the hexagon
% T_888, shaded by the three orientations so that the plane partition of answer
% 262 shows through, with the largest inscribed ellipse; and the blue and red
% paths of D. Randall, laid over a tiling of the Aztec diamond of order 8.
%
% The tilings themselves come out of the ZDD engine of this repository; the
% four defs below hold what it drew.

prologues := 3;                 % so that the standalone SVG carries their fonts

numeric u;                      % one cell
pair o;                         % where the picture being drawn starts
color pathblue, pathred, lean, upright, other;
pathblue := (.13, .28, .78);
pathred  := (.80, .13, .16);
lean     := (.86, .86, .86);
upright  := (.99, .99, .99);
other    := (.72, .72, .72);

vardef at(expr r, c) = o + (c*u, -r*u) enddef;

% A domino whose upper left cell is (r, c); it runs right when h = 1.
def d(expr r, c, h) =
  save w, t; numeric w, t;
  w := if h = 1: 2 else: 1 fi;
  t := if h = 1: 1 else: 2 fi;
  fill at(r,c) -- at(r,c+w) -- at(r+t,c+w) -- at(r+t,c) -- cycle
    withcolor upright;
  draw at(r,c) -- at(r,c+w) -- at(r+t,c+w) -- at(r+t,c) -- cycle;
enddef;

% One segment of a Randall path, from the node above cell (ra, ca) to the node
% above cell (rb, cb).  Colour 0 is blue, 1 is red.
def q(expr ra, ca, rb, cb, col) =
  draw (at(ra,ca) + (.5u,0)) -- (at(rb,cb) + (.5u,0))
    withcolor (if col = 0: pathblue else: pathred fi)
    withpen pencircle scaled .9bp;
enddef;

% The triangle coordinates of answer 7.2.2.1-124: the square lattice sheared so
% that its cells become rhombi, each split by a diagonal into two triangles.
vardef L(expr a, b) = o + ((a + b/2)*u, b*0.8660254*u) enddef;

% A diamond covering the upward triangle (x, y): kind 0 leans one way, kind 1
% stands upright, kind 2 leans the other.
def z(expr x, y, k) =
  save p; path p;
  if k = 0: p := L(x,y) -- L(x+1,y) -- L(x+1,y+1) -- L(x,y+1) -- cycle;
  elseif k = 1: p := L(x+1,y-1) -- L(x+1,y) -- L(x,y+1) -- L(x,y) -- cycle;
  else: p := L(x,y) -- L(x+1,y) -- L(x,y+1) -- L(x-1,y+1) -- cycle;
  fi
  fill p withcolor (if k = 0: lean elseif k = 1: upright else: other fi);
  draw p;
enddef;

