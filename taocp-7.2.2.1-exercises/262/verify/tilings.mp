beginfig(1);
  drawoptions(withpen pencircle scaled .35bp);

  u := 6bp;  o := (108bp, 0);
  tileStrip;
  label.bot(btex $S_{32}$ etex, (204bp, -105bp));

  u := 5bp;  o := (0, -145bp);
  tileAztec;
  draw fullcircle scaled (2*12/sqrt(2)*u) shifted (o + (12u, -12u))
    withcolor pathred withpen pencircle scaled 1bp;
  label.bot(btex the arctic circle etex, (60bp, -268bp));

  u := 7bp;  o := (148bp, -265bp);
  tileHex;
  draw fullcircle scaled (2*6.9282*u) shifted (o + (12u, 6.9282u))
    withcolor pathred withpen pencircle scaled 1bp;
  label.bot(btex $T_{888}$ etex, (232bp, -268bp));

  u := 5.5bp;  o := (320bp, -177bp);
  tilePaths;
  label.bot(btex Randall's paths etex, (364bp, -268bp));
endfig;

end.
