% Exercise 7.2.2.1-442.  The hitori covers with eightfold symmetry, the rarest
% patterns in the gallery of answer 442: one of size 3, two of size 5, two of
% size 7, and eleven of size 9.  A black cell is one that gets blacked out; the
% white cells stay connected, and no white cell can be blackened without either
% breaking that or letting two black cells touch.

prologues := 3;                 % so that the standalone SVG carries its fonts

u := 8 bp;                     % one cell
color blk;
blk := (.13, .13, .13);

def cell(expr o, r, c, ink) =
  begingroup
    save p; path p;
    p := unitsquare scaled u shifted (o + (c*u, -(r+1)*u));
    if ink: fill p withcolor blk; fi
    draw p withpen pencircle scaled .3bp;
  endgroup
enddef;

beginfig(1);
  % a 3x3 cover
  cell((0bp,0bp), 0, 0, true);
  cell((0bp,0bp), 0, 1, false);
  cell((0bp,0bp), 0, 2, true);
  cell((0bp,0bp), 1, 0, false);
  cell((0bp,0bp), 1, 1, false);
  cell((0bp,0bp), 1, 2, false);
