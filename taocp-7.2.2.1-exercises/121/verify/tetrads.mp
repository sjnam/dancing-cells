% Exercise 7.2.2.1-121.  Three pictures of Hao Wang's tetrad tiles, as they are
% specified in exercise 2.3.4.3-5 of Volume 1.  A tetrad is a unit square cut
% into four triangles by its diagonals, and two of them may be placed side by
% side only if the triangles that touch carry the same string of symbols.
%
% The first panel is the tile beta-QTY, drawn the way answer 2.3.4.3-5 draws
% it, with the four strings that its basic codes compose to.  The other two are
% the blocks A_3 and A_5 of answer 7.2.2.1-121, shaded by how many letters each
% triangle carries beyond its digit: none, one, or two.  The nested crosses of
% the construction are what the shading brings out.
%
% blockA3 and blockA5 were written by the verification program.

prologues := 3;                 % so that the standalone SVG carries its fonts

numeric u;                      % one tetrad
pair o;                         % where the picture being drawn starts
color shade[];
shade0 := (1, 1, 1);
shade1 := (.74, .74, .74);
shade2 := (.42, .42, .42);

vardef at(expr r, c) = o + (c*u, -r*u) enddef;

% One tetrad at (r, c); a, b, l, m say how many letters the top, bottom, left
% and right triangles carry.
def t(expr r, c, a, b, l, m) =
  save p; pair p;
  p := at(r,c) + (.5u, -.5u);
  fill at(r,c) -- at(r,c+1) -- p -- cycle withcolor shade[a];
  fill at(r+1,c+1) -- at(r+1,c) -- p -- cycle withcolor shade[b];
  fill at(r+1,c) -- at(r,c) -- p -- cycle withcolor shade[l];
  fill at(r,c+1) -- at(r+1,c+1) -- p -- cycle withcolor shade[m];
  draw at(r,c) -- at(r,c+1) -- at(r+1,c+1) -- at(r+1,c) -- cycle;
  draw at(r,c) -- at(r+1,c+1);
  draw at(r,c+1) -- at(r+1,c);
enddef;

