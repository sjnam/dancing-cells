  t(4,4,1,1,1,1); t(4,5,0,1,1,1); t(4,6,0,0,1,1); t(5,0,1,1,1,2);
  t(5,1,2,1,2,1); t(5,2,0,0,1,1); t(5,3,1,1,1,1); t(5,4,1,1,1,2);
  t(5,5,1,0,2,1); t(5,6,0,0,1,1); t(6,0,1,1,1,1); t(6,1,1,1,1,1);
